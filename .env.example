# ─────────────────────────────────────────────────────────────────────────────
# BUILD-TIME — inlined into the client JS bundle by `next build`.
# These MUST be passed as Docker build args. A runtime-only ConfigMap or
# Kubernetes Secret CANNOT supply them: by the time the container starts, the
# browser bundle has already been compiled with whatever value was present at
# build time. Non-secret by design (the anon key is meant to be public and is
# protected by Supabase Row Level Security).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical external origin, e.g. https://outreach.example.com
# Used to build the OAuth/email-confirmation redirect. Required behind a
# TLS-terminating load balancer: the ALB forwards HTTP internally, so deriving
# the origin from the incoming request yields "http://" and downgrades the
# redirect scheme, which drops Secure cookies.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME SECRETS — never bake these into an image.
# In AWS these come from Secrets Manager via External Secrets Operator.
# NOTE: `next build` copies .env into .next/standalone/.env, so .env MUST be
# listed in .dockerignore or these leak into an image layer.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bearer token gating GET /api/cron. Generate with: openssl rand -hex 32
# Currently UNSET in production, and the guard is written `if (secret && ...)`,
# which means an unset value disables authentication entirely and leaves the
# endpoint open to the internet. Set this.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# SMTP / IMAP fallback — per-user credentials live in the `profiles` table and
# take precedence. These are only used by the legacy global-env send path.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Sender identity for the legacy global send path
# (read in lib/server/mailService.ts — previously undocumented)
MY_NAME=Your Name
MY_EMAIL=your-email@gmail.com
